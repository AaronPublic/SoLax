# --- Supabase (Project Settings -> Database -> Connection string) ---
# Runtime: transaction pooler (port 6543). Used by the app via @prisma/adapter-pg.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct / session connection (port 5432). Used by the Prisma CLI via prisma.config.ts.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- NREL PVWatts v8 (server only). Free key: https://developer.nlr.gov/signup/ ---
# DEMO_KEY works for quick tests but is heavily rate limited.
NREL_API_KEY="DEMO_KEY"
# Optional override; NREL's APIs moved from developer.nrel.gov to developer.nlr.gov.
# PVWATTS_URL="https://developer.nlr.gov/api/pvwatts/v8.json"

# --- Google Maps JavaScript API (browser key; restrict it by HTTP referrer) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Area the map is locked to (default: the whole Philippines): south,west,north,east
NEXT_PUBLIC_MAP_BOUNDS="4.5,116.9,21.2,126.7"
# Where the map opens: lat,lng (default: Manila)
NEXT_PUBLIC_MAP_CENTER="14.5995,120.9842"

# Optional: Overpass servers to try in order (comma-separated). Defaults to overpass-api.de + 3 mirrors.
# OVERPASS_URLS="https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter"

# --- Supabase Auth (login / register). Dashboard -> Project Settings -> API Keys ---
# Both values are public by design; row-level security keeps the REST API away from app tables.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# The "publishable" key (sb_publishable_...), or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
